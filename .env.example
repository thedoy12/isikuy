# Backend
APP_SECRET=               # Application secret used for JWT signing
ADMIN_USERNAME=admin      # Local admin username
ADMIN_PASSWORD=dev12345   # Local admin password

# Database
DATABASE_URL=             # PostgreSQL connection string (postgres://user:pass@host:port/db)

# Flowix
FLOWIX_BASE_URL=https://flowix.web.id/api/v1
FLOWIX_API_KEY=           # Production API key from Flowix
FLOWIX_MERCHANT_ID=       # Merchant ID from Flowix, example MID-XXXX
FLOWIX_WEBHOOK_SECRET=    # Webhook secret/signature key from Flowix
FLOWIX_PRODUCT_CATEGORIES=game,pulsa,data,ewallet,voucher,pln

# Digiflazz supplier
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=       # Username from Digiflazz API connection settings
DIGIFLAZZ_API_KEY=        # Use production key in production, development key locally
DIGIFLAZZ_TESTING=false   # true sends testing flag to Digiflazz transaction endpoint

# AI
GEMINI_API_KEY=           # Google Gemini API key for lightweight text tools

# Pricing
PRODUCT_MARKUP_PERCENT=3  # Added to Flowix product price for profit margin
CHECKOUT_TAX_PERCENT=0    # Legacy checkout tax. Keep 0; margin is handled by product markup.
